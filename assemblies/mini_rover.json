{
  "name": "modkit-mini-rover",
  "description": "160×140 小差速底盘 + ESP32 + ToF；电池/台面电源离板，先验证移动平台接口。",
  "payload_g": 0,
  "max_accel_m_s2": 0.6,
  "components": [
    {"id": "chassis", "type": "frame.chassis_160"},
    {"id": "drive_l", "type": "drive.wheel_65", "parent": "chassis", "port": "drive_left", "servo_id": 1},
    {"id": "drive_r", "type": "drive.wheel_65", "parent": "chassis", "port": "drive_right", "servo_id": 2},
    {"id": "caster_f", "type": "drive.caster", "parent": "chassis", "port": "caster_front"},
    {"id": "caster_r", "type": "drive.caster", "parent": "chassis", "port": "caster_rear"},
    {"id": "esp32", "type": "electronics.esp32", "parent": "chassis", "port": "top", "at": [20, -20]},
    {"id": "buck", "type": "electronics.buck_5v", "parent": "chassis", "port": "top", "at": [40, 20]},
    {"id": "pwr", "type": "power.battery_3s", "offboard": true},
    {"id": "tof", "type": "sensor.tof", "parent": "chassis", "port": "top", "at": [-40, 20]}
  ]
}
